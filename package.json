{
  "name": "tars",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "check": "oxfmt --check src test scripts packages/protocol/src packages/protocol/test && oxlint --deny-warnings src test scripts packages/protocol/src packages/protocol/test && tsc --noEmit && tsc -p packages/protocol/tsconfig.json --noEmit && bun test test/ packages/protocol/test/ && bun run --cwd apps/web check && bun run --cwd apps/web test && gitleaks dir . && osv-scanner scan source -L bun.lock",
    "e2e": "bun scripts/build.ts && bun test/e2e/run.ts",
    "e2e:script": "bun scripts/build.ts && bun test/e2e/script.ts",
    "e2e:pilots": "bun scripts/build.ts && bun test/e2e/pilots.ts",
    "e2e:chat": "bun scripts/build.ts && bun test/e2e/chat.ts",
    "e2e:wiki": "bun scripts/build.ts && bun test/e2e/wiki.ts",
    "e2e:providers": "bun scripts/build.ts && bun test/e2e/providers.ts"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.81",
    "@anthropic-ai/sdk": "1.8.0",
    "@tars/protocol": "workspace:*",
    "commander": "15.1.0",
    "jose": "6.2.17",
    "openai": "7.55.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [],
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vitest": "5.1.0"
  }
}
