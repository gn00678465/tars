{
  "name": "tars",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "check": "oxfmt --check src test scripts && oxlint --deny-warnings && tsc --noEmit && bun test && gitleaks dir . && osv-scanner scan source -L bun.lock",
    "e2e": "bun scripts/build.ts && bun test/e2e/run.ts",
    "e2e:script": "bun scripts/build.ts && bun test/e2e/script.ts",
    "e2e:pilots": "bun scripts/build.ts && bun test/e2e/pilots.ts"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.81",
    "commander": "15.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "typescript": "7.0.2"
  },
  "trustedDependencies": []
}
